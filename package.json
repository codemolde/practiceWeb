{
  "name": "art-practice-reference",
  "version": "1.0.0",
  "description": "Local art practice reference app with spaced repetition",
  "main": "electron-main.js",
  "author": "Daksh Beniwal",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "electron": "electron .",
    "electron:devtools": "electron . --devtools",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^43.8.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.daksh.artpractice",
    "productName": "Art Practice Studio",
    "files": [
      "server.js",
      "electron-main.js",
      "preload.js",
      "child-preload.js",
      "public/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
